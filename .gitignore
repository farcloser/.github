# --- OS noise ---
.DS_Store
Thumbs.db
Desktop.ini

# --- Editor / IDE ---
.idea/
.vscode/
*.swp
*~

# Build output and Go artifacts
/build
/tmp

# Scratch / work-in-progress files
# *.local
# _scratch/
# WIP_*

# =========================
#  Rust
# =========================
# Cargo build output
# /target/

# Cargo.lock: COMMIT for binaries/apps, IGNORE for libraries.
# Uncomment the next line ONLY if this is a published library crate:
# Cargo.lock
# Backup files from `cargo fmt` / rustfmt edits
# **/*.rs.bk

# MSVC debug info (Windows toolchain)
# *.pdb

# =========================
#  Svelte / SvelteKit / Node
# =========================
# Dependencies
# node_modules/

# SvelteKit build + generated types/runtime
# .svelte-kit/

# Vite cache/output
# .vite/
# vite.config.*.timestamp-*

# Package manager debug logs
# npm-debug.log*
# yarn-debug.log*
# yarn-error.log*
# pnpm-debug.log*

# --- added by limen fix: baseline patterns ---
*.local
_scratch/
WIP_*
/target/
**/*.rs.bk
*.pdb
node_modules/
.svelte-kit/
.vite/
vite.config.*.timestamp-*
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
